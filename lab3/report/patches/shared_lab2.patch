 #include <best_fit_pmm.h>
 #include <stdio.h>
 
-//lab2 请补充你在lab2中的代码
+//lab2 function2-2 2413682
+// Reference: current First-Fit framework and the two supplied older Lab2 projects.
+// Keep blocks ordered by address; scan their sizes to implement Best-Fit.
+static free_area_t free_area;
+
+#define free_list (free_area.free_list)
+#define nr_free (free_area.nr_free)
+
+static void
+best_fit_insert_block(struct Page *base) {
+    list_entry_t *le = list_next(&free_list);
+    while (le != &free_list && le2page(le, page_link) < base) {
+        le = list_next(le);
+    }
+    // Insertion before the sentinel also handles the tail; do not traverse
+    // the newly inserted node and accidentally insert it into itself.
+    list_add_before(le, &base->page_link);
+}
+
+static void
+best_fit_merge_block(struct Page *base) {
+    list_entry_t *le = list_prev(&base->page_link);
+    if (le != &free_list) {
+        struct Page *prev = le2page(le, page_link);
+        if (prev + prev->property == base) {
+            prev->property += base->property;
+            ClearPageProperty(base);
+            base->property = 0;
+            list_del(&base->page_link);
+            base = prev;
+        }
+    }
+    le = list_next(&base->page_link);
+    if (le != &free_list) {
+        struct Page *next = le2page(le, page_link);
+        if (base + base->property == next) {
+            base->property += next->property;
+            ClearPageProperty(next);
+            next->property = 0;
+            list_del(&next->page_link);
+        }
+    }
+    // Coalescing changes the number of blocks, not the number of free pages.
+}
+
+static void
+best_fit_init(void) {
+    list_init(&free_list);
+    nr_free = 0;
+}
+
+static void
+best_fit_init_memmap(struct Page *base, size_t n) {
+    assert(n > 0);
+    for (struct Page *p = base; p != base + n; p++) {
+        assert(PageReserved(p));
+        p->flags = 0;
+        p->property = 0;
+        set_page_ref(p, 0);
+    }
+    base->property = n;
+    SetPageProperty(base);
+    best_fit_insert_block(base);
+    best_fit_merge_block(base);
+    nr_free += n;
+}
+
+static struct Page *
+best_fit_alloc_pages(size_t n) {
+    assert(n > 0);
+    if (n > nr_free) {
+        return NULL;
+    }
+    struct Page *best = NULL;
+    for (list_entry_t *le = list_next(&free_list); le != &free_list;
+         le = list_next(le)) {
+        struct Page *p = le2page(le, page_link);
+        if (p->property >= n && (best == NULL || p->property < best->property)) {
+            best = p;
+            if (p->property == n) {
+                break; // An exact fit cannot be improved by a later block.
+            }
+        }
+    }
+    if (best == NULL) {
+        return NULL; // Enough total pages may still be fragmented.
+    }
+    size_t remaining = best->property - n;
+    list_entry_t *prev = list_prev(&best->page_link);
+    list_del(&best->page_link);
+    if (remaining > 0) {
+        struct Page *rest = best + n;
+        rest->property = remaining;
+        SetPageProperty(rest);
+        list_add(prev, &rest->page_link);
+    }
+    ClearPageProperty(best);
+    best->property = 0;
+    nr_free -= n;
+    return best;
+}
+
+static void
+best_fit_free_pages(struct Page *base, size_t n) {
+    assert(n > 0);
+    for (struct Page *p = base; p != base + n; p++) {
+        assert(!PageReserved(p) && !PageProperty(p));
+        p->flags = 0;
+        p->property = 0;
+        set_page_ref(p, 0);
+    }
+    base->property = n;
+    SetPageProperty(base);
+    best_fit_insert_block(base);
+    best_fit_merge_block(base);
+    nr_free += n;
+}
+
+static size_t
+best_fit_nr_free_pages(void) {
+    return nr_free;
+}
 
